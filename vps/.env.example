# Copy this file to .env. Set both values for your GitHub fork and VPS domain.
GRUB_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/grubdrops:latest
GRUB_DOMAIN=miner.example.com
TZ=Europe/Moscow

# Optional override for an external age X25519 key. Normally leave empty:
# the miner creates and stores vps/data/master.key on first startup.
GRUB_MASTER_KEY=

# Used only with compose.local.yaml (for an SSH tunnel/local test).
GRUB_HTTP_PORT=8080

# Keep enabled for HTTPS via Caddy. compose.local.yaml disables it for local HTTP.
GRUB_SECURE_COOKIES=1
